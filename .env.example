GOLF_EMAIL=your@email.com
GOLF_PASSWORD=yourpassword

CALGARY_GOLF_EMAIL=your@email.com
CALGARY_GOLF_PASSWORD=yourpassword

VR_GOLF_EMAIL=your@email.com
VR_GOLF_PASSWORD=yourpassword
VR_PAYMENT_TYPE_ID=   # pin your booking rate (e.g. 2 for annual member); leave blank to auto-detect

# Email alerts — sent after 3 consecutive scan errors so you can remote in and recover
# ALERT_EMAIL must be a Gmail address. GMAIL_APP_PASSWORD is an App Password (not your login
# password) — create one at myaccount.google.com/apppasswords (requires 2FA enabled).
ALERT_EMAIL=your@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
